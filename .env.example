# Copy this file to .env.local (app) and/or .env.test.local (tests) and fill
# in real values. Both are git-ignored — see README.md for how to get each
# value from the Supabase dashboard.

# --- .env.local (required to run `npm run dev`) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- .env.test.local (required to run `npm test`) ---
# Same two vars as above, plus:
SUPABASE_SERVICE_ROLE_KEY=   # needed to create/delete test users

# Optional: uncomment to un-skip the school-teacher edge-function tests
# (requires the migration + create-teacher/manage-teacher edge functions to
# already be deployed — see README.md "Feature-flagged tests")
# FEATURE_SCHOOL_TEACHERS=1
